{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "true",
      "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true"
    }
  },
  "functions": {
    "api/convert.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "style.css"
    },
    "api/example.js": {
      "memory": 256,
      "maxDuration": 10,
      "includeFiles": "example.md"
    },
    "api/upload.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
